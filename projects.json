{
  "schema_version": 1,
  "window_days": 30,
  "client_rule": {
    "targets": ["gfx1151", "gfx1201"],
    "description": "Upstream is green only when a test on the default branch ran on a gfx1151 or gfx1201 GPU; amber when other client hardware was tested; red otherwise."
  },
  "projects": [
    {
      "id": "llamacpp",
      "label": "llama.cpp",
      "repository": "ggml-org/llama.cpp",
      "default_branch": "master",
      "forks": [
        {"repository": "lemonade-sdk/llama.cpp", "role": "ROCm stable builds of upstream tags", "channel": "stable"},
        {"repository": "lemonade-sdk/llamacpp-rocm", "role": "ROCm nightly builds (TheRock)", "channel": "nightly"},
        {"repository": "AMD-Ecosystem/llama.cpp", "role": "gfx11 nightly builds", "channel": "nightly"},
        {"repository": "halo-box/strix-llama.cpp", "role": "Strix Halo tuned builds"},
        {"repository": "ROCm/ggml-staging-automation", "role": "HRX backend, not upstreamed"}
      ],
      "ships": {
        "linux": "ubuntu-rocm archive in every release, and a ROCm docker image",
        "windows": "win-rocm archive in every release"
      },
      "jobs": [
        {"id": "gpu-rocm", "label": "gpu-rocm", "category": "tests", "workflow": "ci-self-hosted-cuda.yml",
         "match": {"name": "gpu-rocm"}, "target": "gfx1151", "stack": "rocm", "os": "linux",
         "where": "Strix Halo, one self-hosted box", "cadence": "per push and pull request"},
        {"id": "models-check-rocm", "label": "models-check rocm", "category": "tests", "workflow": "models-check.yml",
         "match": {"name": "rocm"}, "target": "gfx1201", "stack": "rocm", "os": "linux",
         "where": "Radeon AI PRO R9700 pool", "cadence": "per push and pull request"},
        {"id": "models-check-vulkan", "label": "models-check vulkan-amd", "category": "tests", "workflow": "models-check.yml",
         "match": {"name": "vulkan-amd"}, "target": "gfx1201", "stack": "vulkan", "os": "linux",
         "where": "Radeon AI PRO R9700 pool", "cadence": "per push and pull request"},
        {"id": "hip-build", "label": "hip build", "category": "builds", "workflow": "build-cuda-ubuntu.yml",
         "match": {"name": "hip"}, "target": "gfx1030", "stack": "rocm", "os": "linux",
         "where": "GitHub-hosted, no GPU", "cadence": "per push and pull request"},
        {"id": "rocm-docker", "label": "rocm docker image", "category": "nightlies", "workflow": "docker.yml",
         "match": {"regex": "^Push Docker.*\\(rocm,"}, "target": "image", "stack": "rocm", "os": "linux",
         "where": "GitHub-hosted, no GPU", "cadence": "daily"},
        {"id": "release-ubuntu-rocm", "label": "release ubuntu-rocm", "category": "releases", "workflow": "release.yml",
         "match": {"prefix": "ubuntu-24-rocm"}, "target": "multi-arch", "stack": "rocm", "os": "linux",
         "where": "GitHub-hosted, no GPU", "cadence": "every release tag"},
        {"id": "release-windows-rocm", "label": "release windows-rocm", "category": "releases", "workflow": "release.yml",
         "match": {"prefix": "windows-rocm"}, "target": "multi-arch", "stack": "rocm", "os": "windows",
         "where": "GitHub-hosted, no GPU", "cadence": "every release tag"}
      ]
    },
    {
      "id": "whispercpp",
      "label": "whisper.cpp",
      "repository": "ggml-org/whisper.cpp",
      "default_branch": "master",
      "forks": [
        {"repository": "lemonade-sdk/whisper.cpp-builds", "role": "Lemonade's builds"}
      ],
      "ships": {},
      "jobs": [
        {"id": "npu-amd-linux", "label": "npu-amd-linux", "category": "tests", "workflow": "build-self-hosted.yml",
         "match": {"name": "npu-amd-linux"}, "target": "Ryzen AI NPU", "stack": "npu", "os": "linux",
         "where": "Strix Halo devlab, Linux", "cadence": "per push and pull request"},
        {"id": "npu-amd-windows", "label": "npu-amd-windows", "category": "tests", "workflow": "build-self-hosted.yml",
         "match": {"name": "npu-amd-windows"}, "target": "Ryzen AI NPU", "stack": "npu", "os": "windows",
         "where": "Strix Halo devlab, Windows", "cadence": "per push and pull request"}
      ]
    },
    {
      "id": "unsloth",
      "label": "Unsloth",
      "repository": "unslothai/unsloth",
      "default_branch": "main",
      "tag_pattern": "^v\\d",
      "forks": [],
      "ships": {"linux": "ROCm docker images"},
      "jobs": [
        {"id": "rocm-image", "label": "rocm image", "category": "builds", "workflow": "docker-publish-rocm.yml",
         "match": {"name": "build"}, "target": "generic", "stack": "rocm", "os": "linux",
         "where": "GitHub-hosted, Dockerfile.rocm", "cadence": "weekly and every release tag"},
        {"id": "rocm-studio-image", "label": "rocm studio image", "category": "builds", "workflow": "docker-publish-rocm.yml",
         "match": {"name": "build-studio"}, "target": "generic", "stack": "rocm", "os": "linux",
         "where": "GitHub-hosted, Dockerfile.studio-rocm", "cadence": "weekly and every release tag"},
        {"id": "rocm-smoke-test", "label": "rocm gpu smoke test", "category": "tests", "workflow": "docker-publish-rocm.yml",
         "match": {"name": "smoke-test"}, "target": "AMD GPU runner", "stack": "rocm", "os": "linux",
         "where": "self-hosted amd-gpu, gated on HAS_AMD_GPU_RUNNER", "cadence": "after every image build"}
      ]
    },
    {
      "id": "pytorch",
      "label": "PyTorch",
      "repository": "pytorch/pytorch",
      "default_branch": "main",
      "forks": [
        {"repository": "ROCm/pytorch", "role": "AMD's fork of PyTorch"}
      ],
      "ships": {"linux": "ROCm wheels, built for gfx1151 and gfx1201 among others"},
      "note": "The only client GPU in PyTorch CI is the Radeon RX 7900 (gfx1100); every other ROCm workflow runs on Instinct hardware and is out of scope.",
      "jobs": [
        {"id": "rx7900-build", "label": "rx7900 rocm build", "category": "builds", "workflow": "rocm-rx7900.yml",
         "match": {"regex": "^linux-\\w+-rocm-py3\\.11-rx7900 / build$"}, "target": "gfx1100", "stack": "rocm", "os": "linux",
         "where": "CPU builder", "cadence": "every 2 hours on weekdays"},
        {"id": "rx7900-tests", "label": "rx7900 tests", "category": "tests", "workflow": "rocm-rx7900.yml",
         "match": {"regex": "^linux-\\w+-rocm-py3\\.11-rx7900 / test "}, "target": "gfx1100", "stack": "rocm", "os": "linux",
         "where": "Radeon RX 7900, 2 shards", "cadence": "every 2 hours on weekdays"}
      ]
    },
    {
      "id": "sdcpp",
      "label": "SD.cpp",
      "repository": "leejet/stable-diffusion.cpp",
      "default_branch": "master",
      "forks": [
        {"repository": "lemonade-sdk/stable-diffusion.cpp", "role": "Lemonade's builds"}
      ],
      "ships": {
        "linux": "Linux ROCm archive in every master release",
        "windows": "win-rocm archive in every master release"
      },
      "jobs": [
        {"id": "rocm-build-linux", "label": "rocm build linux", "category": "builds", "workflow": "build.yml",
         "match": {"prefix": "ubuntu-latest-rocm"}, "target": "multi-arch", "stack": "rocm", "os": "linux",
         "where": "GitHub-hosted, no GPU", "cadence": "per push and pull request"},
        {"id": "rocm-build-windows", "label": "rocm build windows", "category": "builds", "workflow": "build.yml",
         "match": {"name": "windows-latest-rocm"}, "target": "multi-arch", "stack": "rocm", "os": "windows",
         "where": "GitHub-hosted, no GPU", "cadence": "per push and pull request"}
      ]
    },
    {
      "id": "vllm",
      "label": "vLLM",
      "repository": "vllm-project/vllm",
      "default_branch": "main",
      "forks": [
        {"repository": "ROCm/vllm", "role": "AMD's fork; carries gfx11 and gfx1151 branches not yet upstream"}
      ],
      "ships": {},
      "note": "No Radeon or Ryzen AI GPU is tested upstream. vLLM's AMD CI runs on Buildkite against MI250, MI300 and MI355 only.",
      "jobs": []
    }
  ]
}
